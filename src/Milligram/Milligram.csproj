<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Milligram</RootNamespace>
    <StartupObject>Milligram.Main.Program</StartupObject>
    <!-- Releases take their version from the git tag (see .github/workflows/release.yml). -->
    <Version>0.0.0-dev</Version>
    <Description>A live architecture viewer for C# codebases, with a companion agent.</Description>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>milligram</ToolCommandName>
    <PackageId>Milligram</PackageId>
    <PackageOutputPath>../../artifacts</PackageOutputPath>
    <Authors>Jama Noor</Authors>
    <Copyright>Copyright (c) 2026 Jama Noor</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://jhnoor.github.io/milligram/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jhnoor/milligram</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>architecture;diagram;csharp;roslyn;crap;coverage;mutation-testing;stryker;copilot</PackageTags>

    <!-- The viewer's web assets are embedded so the tool runs from anywhere. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>

    <!-- The Web SDK runs `dotnet run` in the project directory; run where invoked, like the installed tool. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <None Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md;../../LICENSE;../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Milligram.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
    <PackageReference Include="Porta.Pty" Version="2.2.2" />
  </ItemGroup>

</Project>
