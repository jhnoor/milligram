<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>milligram-pty-spike</ToolCommandName>
    <PackageId>Milligram.PtySpike</PackageId>
    <Version>0.0.0-spike</Version>
    <PackageOutputPath>../../artifacts/pty</PackageOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="2.2.2" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
